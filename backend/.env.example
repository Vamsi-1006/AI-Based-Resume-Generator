# Copy this file to ".env" (same folder as pom.xml) and fill in at least ONE key.
# Spring Boot loads it automatically (see spring.config.import in application.yml).

# --- Default provider + fallback chain ---------------------------------------
LLM_PROVIDER=groq
LLM_FALLBACK=groq,groq-fast,gemini,openrouter,xai,openai,anthropic,ollama

# --- Groq (free tier, no card) : https://console.groq.com/keys ----------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Google Gemini (free tier) : https://aistudio.google.com/apikey ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (has :free models) : https://openrouter.ai/keys --------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- xAI Grok (trial credits) : https://console.x.ai -------------------------
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# --- OpenAI / Anthropic (paid) -----------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Ollama (local) ----------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_MODEL=phi3

# --- App ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_RPM=20
